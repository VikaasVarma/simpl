{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.ts",
    "src/graph/graphTypes.ts",
    "src/vendor.d.ts",
    "generated/**/*.ts",
    "generated/**/*.json"
  ]
}
