{
  "name": "working-notes-canvas",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:graph": "tsx scripts/build-obsidian-graph.ts",
    "generate:graph:published": "tsx scripts/build-obsidian-graph.ts --published",
    "audit:dist": "tsx scripts/audit-dist.ts",
    "settle:seeds": "tsx scripts/settle-graph-seeds.ts",
    "check": "npm run generate:graph && tsc --noEmit && npm run typecheck:scripts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "dev": "npm run generate:graph && vite --host 127.0.0.1",
    "build": "npm run generate:graph && tsc --noEmit && npm run typecheck:scripts && vite build",
    "build:published": "npm run generate:graph:published && tsc --noEmit && npm run typecheck:scripts && vite build && npm run audit:dist",
    "build:site": "npm run build:published",
    "publish:notes": "npm run build:published",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@shikijs/transformers": "^4.3.1",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^24.0.0",
    "@types/three": "^0.185.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.17.0",
    "markdown-it": "^14.3.0",
    "markdown-it-footnote": "^4.0.0",
    "sass": "^1.90.0",
    "shiki": "^4.3.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/source-serif-4": "^5.2.9",
    "d3-force-3d": "^3.0.6",
    "three": "^0.185.1",
    "troika-three-text": "^0.52.4"
  }
}
